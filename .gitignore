.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.venv-qt/
internpearls/user_files/

# Only the distributable project belongs at the repository root.
/*
!/.gitignore
!/.nvmrc
!/.github/
!/CHANGELOG.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/browser_tests/
!/build.sh
!/conftest.py
!/demo/
!/docs/
!/internpearls/
!/internpearls.ankiaddon
!/package-lock.json
!/package.json
!/pytest.ini
!/qt_tests/
!/tests/
!/tools/
!/version.json

/.demo-tools/
/node_modules/
/test-results/
/playwright-report/

# Only the live demo is published from docs/.
/docs/*
!/docs/.nojekyll
!/docs/index.html
!/docs/demo-contract.js
!/docs/demo_harness.py
!/docs/addon/

/.github/*
!/.github/workflows/
